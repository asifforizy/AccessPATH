model AuditLog {
  id         String   @id @default(uuid())

  action     String
  entityType String
  entityId   String?

  metadata   Json?

  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
model Notification {
  id        String   @id @default(uuid())

  title     String
  message   String
  type      String

  isRead    Boolean  @default(false)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}
